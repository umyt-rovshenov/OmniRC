# Copy this file to .env.local and fill in your own values.
#
#   cp .env.example .env.local
#
# .env.local is listed in .gitignore and must never be committed. This file,
# with placeholder values only, is the one that belongs in the repository.
#
# Nothing in the firmware build reads these. They exist so that credentials
# needed while working on the project live in one known place instead of being
# pasted into chat logs, issues or commit messages.

# GitHub personal access token, if a task needs one beyond `gh auth login`.
# Grant it the narrowest scope that does the job, and revoke it when done.
GITHUB_TOKEN=

# Wi-Fi credentials used by the service mode tests, once that phase exists.
WIFI_SSID=
WIFI_PASSWORD=
